            "description": {
              "content": "Execute a Solr query against Maven Central. Use the `q` parameter with Solr field syntax to filter by groupId (`g:`), artifactId (`a:`), version (`v:`), classname (`c:`), fully-qualified classname (`fc:`), SHA-1 checksum (`1:`), or tags (`tags:`).",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "select"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
